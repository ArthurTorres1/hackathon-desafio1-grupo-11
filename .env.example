# Credenciais exclusivamente locais de desenvolvimento. Não utilizar em hospedagem pública.
POSTGRES_DB=foresttrace
POSTGRES_USER=foresttrace_owner
POSTGRES_PASSWORD=foresttrace_dev_owner
POSTGRES_APP_PASSWORD=foresttrace_dev_app
POSTGRES_PORT=5433
DATABASE_URL=postgresql://foresttrace_app:foresttrace_dev_app@127.0.0.1:5433/foresttrace?schema=public
DIRECT_URL=postgresql://foresttrace_owner:foresttrace_dev_owner@127.0.0.1:5433/foresttrace?schema=public
TEST_DATABASE_URL=postgresql://foresttrace_owner:foresttrace_dev_owner@127.0.0.1:5433/foresttrace_test?schema=public
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
DEMO_MODE=true
PRIVATE_STORAGE_DIR=data/private
# Sem chave: fixture explícita, SEM_INTEGRACAO_REAL e pacote MISSING_EVIDENCE.
WHISP_API_KEY=
WHISP_SUBMIT_URL=
WHISP_CONTRACT_CONFIRMED=false
